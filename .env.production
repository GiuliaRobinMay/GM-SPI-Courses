# Supabase connection, read at build time.
#
# Both values are meant to be public. The publishable key is designed to ship
# inside the browser bundle — it is in the JavaScript of the live site either
# way — and row level security in supabase/schema.sql is what actually
# protects the data: every row is keyed to auth.uid(), so a signed-in person
# can only ever read and write their own.
#
# Keeping them here means a deploy works with nothing to configure. To manage
# them in Vercel instead, set the same names under Settings → Environment
# Variables; those take precedence over this file.
#
# The secret / service_role key must NEVER appear here or in any NEXT_PUBLIC_
# variable. It bypasses row level security entirely.

NEXT_PUBLIC_SUPABASE_URL=https://lhatdcyllmiwordyoyeo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_WhWGH7oG7LcqyiAurwkE8A_ZVkWohwV
