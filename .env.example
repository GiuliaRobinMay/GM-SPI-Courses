# Studiolo runs with no configuration at all: leave this file unused and the
# library is stored in your browser (IndexedDB), on one device, with no account.
#
# Set both values and the app switches to Supabase — an account, and the same
# library on every device. Run supabase/schema.sql in the SQL editor first.
#
# Find them in your Supabase project under Settings → API.
# Both are safe in the browser; row level security is what protects the data.
#
# Copy this file to .env.local for local development, and add the same two
# values in Vercel under Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Whichever your dashboard shows. Set one; either name works.
#   newer projects: a publishable key, starting sb_publishable_
#   older projects: an anon / public key, a long string starting eyJ
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
# It bypasses every security rule and NEXT_PUBLIC_ ships to the browser.
